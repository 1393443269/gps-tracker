# GPS 平台环境变量配置示例
# 复制本文件为 .env，填入真实值后启动 docker-compose
# 警告：.env 文件包含密钥，不可提交到 Git（已在 .gitignore 中排除）

# ── 数据库 ────────────────────────────────────────────────────────────────────
POSTGRES_USER=gps
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=gps
DATABASE_URL=postgresql://gps:CHANGE_ME_strong_db_password@postgres:5432/gps

# ── 管理员 Token 签名密钥（建议 openssl rand -hex 32 生成）────────────────────
ADMIN_SECRET=CHANGE_ME_use_openssl_rand_hex_32
PORTAL_SECRET=CHANGE_ME_use_openssl_rand_hex_32_different

# ── MQTT 认证 ─────────────────────────────────────────────────────────────────
MQTT_USER=gps_device
MQTT_PASS=CHANGE_ME_mqtt_password

# ── 天地图 Token（地图底图 SDK，前端构建时注入）────────────────────────────────
# 在天地图开发者平台申请：https://console.tianditu.gov.cn/
VITE_TDT_TOKEN=CHANGE_ME_tianditu_token

# ── 可选：腾讯位置服务 Key（WiFi/基站/蓝牙坐标换算）──────────────────────────
# 在腾讯位置服务控制台申请：https://lbs.qq.com/dev/console/application/mine
# 个人开发者注册即可免费用「网络定位」接口（有每日额度）。不配则 WiFi/基站定位不出点，
# 不影响 GPS 定位。真实 Key 填到 .env（本文件仅示例，勿写真实值）。
# TENCENT_LBS_KEY=your_tencent_lbs_key

# ── 本地开发专用（生产必须删除或设为 0）──────────────────────────────────────
# ALLOW_DEV_SECRET=1
# DEBUG_MODE=0

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.venv/
venv/
env/

# ── 数据库 & 日志（不入库，运行时生成）──────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.log
server/app.log
server/server.log
server/server_err.log

# ── Node / 前端构建 ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
.npm/
npm-debug.log*

# ── 系统文件 ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── 用户上传文件（头像等，运行时生成，不入库）────────────────────────────────
server/uploads/

# ── QA 快照（开发工具内部，不需要入库）──────────────────────────────────────
.qa-snapshots/

# ── 临时文件 ─────────────────────────────────────────────────────────────────
*.tmp
*.bak
~$*
null

# ── MQTT 凭证文件（含明文密码，禁止入库）──────────────────────────────────
passwd
mqtt_credentials.txt

# ── 环境变量 / 密钥（禁止入库！复制 .env.example → .env 并填入真实值）────────
.env
*.env
!.env.example
